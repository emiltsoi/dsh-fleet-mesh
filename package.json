{
  "name": "dsh-fleet-mesh",
  "version": "0.2.5",
  "description": "Session-aware mesh relay for DSH agents: an Ed25519-signed receive route and delivery policy, plus outbound sending, a peer directory and a mesh-peer-registry client.",
  "type": "module",
  "license": "MIT",
  "author": "Emil Tsoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiltsoi/dsh-fleet-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/emiltsoi/dsh-fleet-mesh/issues"
  },
  "homepage": "https://github.com/emiltsoi/dsh-fleet-mesh#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.2"
  },
  "scripts": {
    "test": "node test/pyjson.test.mjs && node test/mesh.test.mjs && node test/outbound.test.mjs && node test/smoke.mjs && node test/roundtrip.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mesh",
    "agent-mesh",
    "fleet",
    "ed25519",
    "hermes-mesh",
    "a2a"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
